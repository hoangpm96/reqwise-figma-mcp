rankdir LR
lane user "User"
lane sys "Booking System"
lane pay "Payment Gateway" ext
lane mail "Email Service" ext
user: s start "Visits the website"
user: selMovie "Select a movie"
sys: showtimes "Display available showtimes"
user: pickShow "Pick a showtime"
sys: isLogged ? "User logged in?"
sys: promptLogin "Prompt login | email + password"
user: enterCreds "Enter email and password"
sys: authOk ? "Credentials valid?"
sys: loginErr err "Show login error"
sys: seatChart "Show seating chart | and available seats"
user: selSeats "Select number of seats | and seat positions"
sys: seatsFree ? "Seats still available?"
sys: seatErr err "Show \"Seats unavailable\""
sys: reserve "Reserve seats | temporarily for 10 minutes"
user: confirm "Confirm order and choose | payment method (card / e-wallet)"
pay: process ext "Process the payment"
sys: payOk ? "Payment successful?"
sys: retryLeft ? "Failed attempts < 3?"
sys: payErr err "Show payment error"
sys: cancel err "Cancel the transaction | and release reserved seats"
sys: endCancel end err "Transaction cancelled"
sys: ticket ok "Generate the e-ticket"
sys: fk fork "Deliver the ticket"
mail: sendMail ext ok "Send the e-ticket by email"
sys: qr ok "Display the QR code"
sys: jn join "Ticket delivered"
user: endOk end ok "User has the ticket"
s > selMovie
selMovie > showtimes "selected movie"
showtimes > pickShow "list of showtimes"
pickShow > isLogged "chosen showtime"
isLogged > seatChart "yes"
isLogged > promptLogin "no"
promptLogin > enterCreds "login prompt"
enterCreds > authOk "email + password"
authOk > seatChart "login succeeds"
authOk > loginErr "login fails"
loginErr ~> enterCreds "error message, retry"
seatChart > selSeats "seating chart"
selSeats > seatsFree "seat selection"
seatsFree > reserve "yes"
seatsFree > seatErr "no, already booked"
seatErr ~> selSeats "\"Seats unavailable\", reselect"
reserve > confirm "seats held for 10 min"
confirm > process "order + payment method"
process > payOk "payment result"
payOk > ticket "payment succeeds"
payOk > retryLeft "payment fails"
retryLeft > payErr "yes, retry allowed"
retryLeft > cancel "no, 3 attempts used"
payErr ~> confirm "error message, pay again"
cancel > endCancel
ticket > fk
fk > sendMail "e-ticket"
fk > qr
sendMail > jn "email sent"
qr > jn
jn > endOk "e-ticket + QR code"
